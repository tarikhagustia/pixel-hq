# Copy to .env and adjust as needed. All values shown are the built-in defaults.

# Port the server (and /ws) listens on.
PORT=3001

# Max concurrent players in the office.
MAX_PLAYERS=16

# JSON array of RTCIceServer. Add a TURN server here for users behind
# symmetric/corporate NAT (the default is STUN-only and can't traverse those).
# Ignored when CLOUDFLARE_TURN_TOKEN_ID + CLOUDFLARE_TURN_API_TOKEN are set below.
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:your-turn-host:3478"],"username":"user","credential":"pass"}]

# Directory of built client assets served by the server (only used by `npm start`,
# i.e. the production build; `npm run dev` serves the client via Vite instead).
# STATIC_DIR=../client/dist

# Cloudflare Calls TURN service (https://dash.cloudflare.com -> Calls -> TURN).
# When both are set, the server fetches short-lived TURN credentials from
# Cloudflare's API on demand (per client, cached until shortly before they
# expire) instead of using the static ICE_SERVERS above. This is required
# because Cloudflare TURN credentials are ephemeral by design and rotate —
# hardcoding them in ICE_SERVERS breaks once they expire.
# CLOUDFLARE_TURN_TOKEN_ID=your-turn-token-id
# CLOUDFLARE_TURN_API_TOKEN=your-turn-api-token
